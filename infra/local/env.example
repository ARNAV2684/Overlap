# Local settings for the screen and archive flows. Copy to .env.local (ignored by git).
# The keys below are Microsoft's public, documented emulator values: they only work against emulators on localhost.
# On Azure these settings change to real endpoints and services sign in with managed identity (no keys).

# Event Hubs (emulator)
OVERLAP_EVENTHUBS_CONNECTION="Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
OVERLAP_EVENTS_HUB=match-events
OVERLAP_TRACKING_HUB=match-tracking

# Web PubSub (our stand-in)
OVERLAP_WEBPUBSUB_ENDPOINT=http://localhost:8787
OVERLAP_WEBPUBSUB_HUB=live

# Cosmos DB (emulator)
OVERLAP_COSMOS_ENDPOINT=http://localhost:8081
# Microsoft's public, well-known emulator key (https://learn.microsoft.com/azure/cosmos-db/emulator#authentication).
# It only works against the emulator on localhost; Azure uses managed identity, never a key.
OVERLAP_COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
OVERLAP_COSMOS_DATABASE=live
OVERLAP_COSMOS_CONTAINER=screen

# Archiver: Cosmos containers matches/events/stats in the database above; tracking files in Azurite
OVERLAP_ARCHIVER_CONSUMER_GROUP=archiver
OVERLAP_ARCHIVE_STORAGE="UseDevelopmentStorage=true"

# Functions host storage (Azurite)
AzureWebJobsStorage="UseDevelopmentStorage=true"
