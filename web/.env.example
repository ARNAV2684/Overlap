NEXT_PUBLIC_DEFAULT_MATCH_ID=SYN-9001

# Live stream (server only: read by /api/negotiate and /api/match/<id>/snapshot, never sent to the browser).
# web/specs/realtime.md §1.1 and §3.1. Local values match infra/local/env.example (Web PubSub stand-in and Cosmos
# emulator). Without them the live screen says it cannot reach the stream server.
# The stand-in locally; https://<name>.webpubsub.azure.com on Azure (managed identity, no key).
OVERLAP_WEBPUBSUB_ENDPOINT=http://localhost:8787
OVERLAP_WEBPUBSUB_HUB=live
# The screen relay's container in the Cosmos database below (OVERLAP_COSMOS_* are shared with the archive).
OVERLAP_COSMOS_CONTAINER=screen

# Match archive (server only: read by /api/replay and /api/matches, never sent to the browser). web/specs/realtime.md
# §5.1 and §5.3. Optional: without them the live screen still runs, /api/replay answers 503 replay_unavailable and the
# match picker's /api/matches answers 503 matches_unavailable.
# Local values match infra/local/env.example (Cosmos emulator and Azurite).
OVERLAP_COSMOS_ENDPOINT=
OVERLAP_COSMOS_DATABASE=live
# Local emulator only: copy the emulator's public key from infra/local/env.example. Leave empty on Azure, where the
# app signs in with its managed identity.
OVERLAP_COSMOS_KEY=
# Tracking files: a connection string locally (Azurite), or the Blob endpoint on Azure (managed identity). Set one.
OVERLAP_ARCHIVE_STORAGE="UseDevelopmentStorage=true"
OVERLAP_ARCHIVE_BLOB_ENDPOINT=

# Public generator starts are disabled unless explicitly enabled (server-side).
OVERLAP_LIVE_ENABLED=false
