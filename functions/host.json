{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "eventHubs": {
      "maxEventBatchSize": 100,
      "prefetchCount": 300,
      "batchCheckpointFrequency": 1
    }
  },
  "logging": {
    "logLevel": {
      "default": "Information",
      "Azure.Core": "Warning",
      "Azure.Identity": "Warning",
      "Azure.Messaging.EventHubs": "Warning",
      "Host.Results": "Information",
      "Function": "Information"
    }
  }
}
